classDiagram
    class Singleton {
        -static Singleton* instance
        -static mutex mtx
        -Singleton()
        +static Singleton* getInstance()
    }

    class Main {
        +main() int
    }

    Main ..> Singleton : calls getInstance() for s1
    Main ..> Singleton : calls getInstance() for s2
    Singleton ..> mutex : uses lock_guard in second check
    Singleton --> Singleton : double-check lazy creation
