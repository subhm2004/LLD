%% Facade Design Pattern - Project Study Diagram
%% Source analyzed from:
%% - C++ Code/FacadePattern.cpp
%% - C++ Code/markdown.md
%% - C++ Code/Principle_of_least_knowledge.md

classDiagram
    direction LR

    class Client {
        +main()
    }

    class ComputerFacade {
        -PowerSupply powerSupply
        -CoolingSystem coolingSystem
        -CPU cpu
        -Memory memory
        -HardDrive hardDrive
        -BIOS bios
        -OperatingSystem os
        +startComputer()
    }

    class PowerSupply {
        +providePower()
    }

    class CoolingSystem {
        +startFans()
    }

    class CPU {
        +initialize()
    }

    class Memory {
        +selfTest()
    }

    class HardDrive {
        +spinUp()
    }

    class BIOS {
        +boot(CPU&, Memory&)
    }

    class OperatingSystem {
        +load()
    }

    Client --> ComputerFacade : uses
    ComputerFacade *-- PowerSupply
    ComputerFacade *-- CoolingSystem
    ComputerFacade *-- CPU
    ComputerFacade *-- Memory
    ComputerFacade *-- HardDrive
    ComputerFacade *-- BIOS
    ComputerFacade *-- OperatingSystem
    BIOS ..> CPU : initializes
    BIOS ..> Memory : validates

---

flowchart TD
    A[Client: main] --> B[Create ComputerFacade]
    B --> C[startComputer()]
    C --> D[powerSupply.providePower()]
    D --> E[coolingSystem.startFans()]
    E --> F[bios.boot(cpu, memory)]
    F --> G[cpu.initialize()]
    F --> H[memory.selfTest()]
    H --> I[hardDrive.spinUp()]
    I --> J[os.load()]
    J --> K[Computer Booted Successfully]

---

mindmap
  root((Facade Pattern Study))
    Intent
      Simplified interface to complex subsystem
      Hide call sequence from client
    Participants
      Client
      Facade
      Subsystems
    Benefits
      Low coupling
      Better readability
      Safer operation order
      Easy maintenance
    Risks
      Overgrown facade (God Object)
      Too many wrapper methods
    Related Principle
      Principle of Least Knowledge
      Talk to immediate neighbors
