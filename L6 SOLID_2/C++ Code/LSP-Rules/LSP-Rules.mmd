flowchart TD
    A[LSP Rules] --> B[Method Rules]
    A --> C[Signature Rules]
    A --> D[Property Rules]

    B --> B1[Preconditions]
    B --> B2[Postconditions]
    B1 --> B1a[User -> AdminUser]
    B1a --> B1ok[Child weakens precondition<br/>LSP Followed]
    B2 --> B2a[Car -> HybridCar]
    B2a --> B2ok[Child strengthens postcondition<br/>LSP Followed]

    C --> C1[Method Argument Rule]
    C --> C2[Return Type Rule]
    C --> C3[Exception Rule]
    C1 --> C1a[Parent.print(string) -> Child.print(string)]
    C1a --> C1ok[Compatible signature<br/>LSP Followed]
    C2 --> C2a[Parent.getAnimal() contract preserved]
    C2a --> C2ok[Compatible return behavior<br/>LSP Followed]
    C3 --> C3a[Parent throws logic_error<br/>Child throws out_of_range]
    C3a --> C3ok[Narrower/compatible exception<br/>Design-wise LSP Followed]

    D --> D1[Class Invariants]
    D --> D2[History Constraint]
    D --> D3[final Notes]
    D1 --> D1a[BankAccount -> CheatAccount]
    D1a --> D1bad[Negative balance allowed<br/>LSP Broken]
    D2 --> D2a[BankAccount -> FixedDepositAccount]
    D2a --> D2bad[withdraw disallowed in child<br/>LSP Broken]
    D3 --> D3a[final class/final method]
    D3a --> D3note[Inheritance control note]

    B1ok:::good
    B2ok:::good
    C1ok:::good
    C2ok:::good
    C3ok:::good
    D1bad:::bad
    D2bad:::bad
    D3note:::neutral

    classDef good fill:#e8f5e9,stroke:#2e7d32,stroke-width:1px,color:#1b5e20;
    classDef bad fill:#ffebee,stroke:#c62828,stroke-width:1px,color:#b71c1c;
    classDef neutral fill:#e3f2fd,stroke:#1565c0,stroke-width:1px,color:#0d47a1;
